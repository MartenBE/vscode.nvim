#!/usr/bin/env sh

# Visual Studio Code light (Modern) color scheme for fzf

# .profile, .bash_profile, .zshenv

export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS"'
  --color=fg:#3b3b3b,fg+:#000000,bg:#ffffff,bg+:#e8e8e8
  --color=hl:#0066bf,hl+:#0066bf,info:#616161,marker:#005fb8
  --color=prompt:#005fb8,spinner:#005fb8,pointer:#005fb8,header:#616161
  --color=border:#e5e5e5,label:#3b3b3b,query:#3b3b3b'
