#!/usr/bin/env sh

# Visual Studio Code dark (Modern) color scheme for fzf

# .profile, .bash_profile, .zshenv

export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS"'
  --color=fg:#cccccc,fg+:#ffffff,bg:#1f1f1f,bg+:#04395e
  --color=hl:#2aaaff,hl+:#2aaaff,info:#9d9d9d,marker:#0078d4
  --color=prompt:#0078d4,spinner:#0078d4,pointer:#0078d4,header:#9d9d9d
  --color=border:#2b2b2b,label:#cccccc,query:#cccccc'
