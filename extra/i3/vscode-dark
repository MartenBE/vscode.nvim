# class, border, bg, text, indicator, child border
client.focused           $color6 $color6 $background $color6 $color6
client.focused_inactive  $color8 $color8 $background $color8 $color8
client.unfocused         $color8 $background $color8 $color8 $color8
client.focused_tab_title $color6 $background $color6
client.urgent            $color3 $background $color3 $color8 $color8
client.placeholder       $color6 $background $color6 $color6 $color8

client.background $color6

bar {
  colors {
    background         $background
    statusline         $color8
    separator          $color8
    focused_workspace  $color6 $color6 $background
    active_workspace   $color8 $color8 $background
    inactive_workspace $background $background $color8
    urgent_workspace   $color3 $color3 $background
    binding_mode       $color5 $color5 $background
  }
}
