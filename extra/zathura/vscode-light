# vscode light zathura colorscheme

set default-bg                  "#ffffff"
set default-fg                  "#3b3b3b"

set statusbar-bg                "#f8f8f8"
set statusbar-fg                "#3b3b3b"

set inputbar-bg                 "#f8f8f8"
set inputbar-fg                 "#3b3b3b"

set notification-error-bg       "#ffffff"
set notification-error-fg       "#e51400"

set notification-warning-bg     "#ffffff"
set notification-warning-fg     "#bf8803"

set highlight-color             "rgba(173,214,255,0.5)"
set highlight-active-color      "rgba(168,172,148,0.5)"

set highlight-fg                "#3b3b3b"

set completion-highlight-fg     "#000000"
set completion-highlight-bg     "#e8e8e8"

set completion-bg               "#f8f8f8"
set completion-fg               "#3b3b3b"

set notification-bg             "#ffffff"
set notification-fg             "#3b3b3b"

set recolor-lightcolor          "#ffffff"
set recolor-darkcolor           "#3b3b3b"

set index-fg                    "#3b3b3b"
set index-bg                    "#ffffff"

set index-active-fg             "#000000"
set index-active-bg             "#e8e8e8"
