# vscode dark zathura colorscheme

set default-bg                  "#1f1f1f"
set default-fg                  "#cccccc"

set statusbar-bg                "#181818"
set statusbar-fg                "#cccccc"

set inputbar-bg                 "#181818"
set inputbar-fg                 "#cccccc"

set notification-error-bg       "#1f1f1f"
set notification-error-fg       "#f14c4c"

set notification-warning-bg     "#1f1f1f"
set notification-warning-fg     "#cca700"

set highlight-color             "rgba(38,79,120,0.5)"
set highlight-active-color      "rgba(158,106,3,0.5)"

set highlight-fg                "#cccccc"

set completion-highlight-fg     "#ffffff"
set completion-highlight-bg     "#04395e"

set completion-bg               "#181818"
set completion-fg               "#cccccc"

set notification-bg             "#1f1f1f"
set notification-fg             "#cccccc"

set recolor-lightcolor          "#1f1f1f"
set recolor-darkcolor           "#cccccc"

set index-fg                    "#cccccc"
set index-bg                    "#1f1f1f"

set index-active-fg             "#ffffff"
set index-active-bg             "#04395e"
